{
    "name": "axon",
    "productName": "Axon",
    "private": true,
    "version": "0.0.0",
    "description": "Local AI desktop agent for Windows",
    "author": "Ben Omoroje",
    "main": "main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "electron": "electron .",
        "start": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
        "package": "set CSC_SKIP=true && vite build && electron-builder --win"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "framer-motion": "^12.40.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwindcss": "^4.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "concurrently": "^9.2.1",
        "electron": "^42.2.0",
        "electron-builder": "^26.8.1",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "vite": "^8.0.12",
        "wait-on": "^9.0.10"
    },
    "build": {
        "appId": "com.axon.app",
        "productName": "Axon",
        "win": {
            "target": "nsis",
            "icon": "icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "files": [
            "dist/**/*",
            "main.cjs",
            "preload.cjs",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../assets",
                "to": "assets"
            }
        ]
    }
}
